# Copy to .env (never commit it) or set these in your host's dashboard.
NODE_ENV=production
PORT=3000
# Your public address, used for canonical links, sitemap and social previews:
SITE_URL=https://www.your-domain.example
# First admin. Created on first start only. Use a long unique password (12+ characters).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Set to 1 when running behind a proxy/host that terminates HTTPS (Render, Railway, Fly, nginx...)
TRUST_PROXY=1
# Where the database and uploaded images live. Point this at a persistent disk/volume.
DATA_DIR=./data
